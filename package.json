{
  "name": "@revheat/ui",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "//scripts": "Named 'compile' NOT 'build' on purpose: pacote treats a 'build' (or prepare/install/prepack) script as a trigger to run `npm install` inside the git-dep clone, which pulls this package's devDeps and crashes arborist. dist/ is committed, so consumers never build. After editing src/, run `npm run compile` and commit dist/.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./catalog": { "types": "./dist/catalog.d.ts", "default": "./dist/catalog.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "compile": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "happy-dom": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
